# KAYA — backend environment
#
# Copy to .env and fill in. Everything below is either required or has a note
# saying what happens when it is left blank. This file used to be stock Laravel
# (sqlite, MAIL_MAILER=log, no Google, no Reverb), which meant a new machine
# could not run the project without reading someone else's .env.
#
#   cp .env.example .env
#   php artisan key:generate
#   php artisan migrate --seed

APP_NAME=KAYA
APP_ENV=local
APP_KEY=
# Never true in production — an exception page prints the stack trace, the
# query it failed on, and the environment.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_TIMEZONE=Asia/Manila

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL, not sqlite: several migrations use MySQL-only column types, and one
# early-returns on sqlite — so a sqlite database ends up with a different
# schema from production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaya_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue ─────────────────────────────────────────────────────────────────────
# `database` needs a worker running (php artisan queue:work), or queued jobs
# sit unprocessed. `sync` runs them inline, which is fine locally.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

FILESYSTEM_DISK=local

# ── Admin panel ───────────────────────────────────────────────────────────────
# Pinned so re-seeding cannot change the credentials underneath you. AdminSeeder
# refuses to run in production when the email or password is missing, rather than
# falling back to a default password that would be identical on every install.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@kaya.local
ADMIN_PASSWORD=

# ── Mail ──────────────────────────────────────────────────────────────────────
# Used for password reset and email verification codes. With MAIL_MAILER=log
# the mail is written to storage/logs instead of being sent — fine for local
# work, but the verification code then only exists in that file.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google sign-in ────────────────────────────────────────────────────────────
# The OAuth *Web application* client ID from Google Cloud Console. Every
# incoming Google ID token is checked against this as its audience, which is
# what stops a token minted for another application being accepted here.
#
# Not a secret — it ships inside the Android app. Sign-in fails shut when unset
# rather than trusting the client, so leaving it blank disables Google sign-in
# without disabling anything else.
#
# The Flutter app needs the same value:
#   flutter build apk --dart-define=GOOGLE_SERVER_CLIENT_ID=<same value>
GOOGLE_CLIENT_ID=

# ── SMS (phone verification) ──────────────────────────────────────────────────
# Semaphore — the common Philippine option, credits without a subscription.
# Unset means phone verification answers 503 and the app says it is
# unavailable. It never pretends to send a code.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# ── Realtime ─────────────────────────────────────────────────────────────────
#
# Two options. Both speak the Pusher protocol, so the app connects to either
# without a rebuild — it asks /api/v1/realtime/config where to dial at runtime.
#
#
# OPTION A: Laravel Reverb, self-hosted.  Start with: php artisan reverb:start
#
# Free and fully under your control, but it is a second server on its own port,
# and it is NOT covered by whatever tunnel serves the REST API. REVERB_HOST is
# the address the *phone* dials, so on a dev machine it ends up being a LAN
# address — which resolves only on that same WiFi. The result is realtime that
# works at your desk and is dead on mobile data, while the API keeps working,
# because the API is tunnelled and the socket is not.
#
# To use it away from your own network the socket port needs its own public
# address too: a second tunnel to REVERB_SERVER_PORT, or a real deployment
# where both sit behind one domain (then REVERB_HOST=your-domain,
# REVERB_SCHEME=https, REVERB_PORT=443).
#
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
#
#
# OPTION B: Pusher, hosted.  Set BROADCAST_CONNECTION=pusher above.
#
# Removes the reachability problem entirely — Pusher is on the public internet,
# so the phone reaches it from any network with no tunnel, no LAN address, and
# nothing extra to keep running. Their free tier (200k messages/day, 100
# concurrent connections) is well beyond what this app needs, and private
# channels are still authorised by this server via /api/broadcasting/auth, so
# the security model does not change.
#
# The cluster is the region: ap1 is Singapore, the nearest to the Philippines.
# Only the KEY reaches the app; the secret stays here and signs channel grants.
#
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origin allowlist. Leaving it empty falls back to '*', which is
# only acceptable locally — set it on the deployed environment.
#
# A native Android app sends no Origin header and is unaffected either way. This
# governs browsers only, so it matters for the admin panel, not for the phone.
CORS_ALLOWED_ORIGINS=

# Note: there is no TRUSTED_PROXIES variable. Proxy trust is set in
# bootstrap/app.php, which runs before config is available and so cannot read
# env. Change it there if your platform needs something narrower than '*'.

# ── Object storage (deployment) ───────────────────────────────────────────────
# Uploads go to the container filesystem by default, so every worker photo and
# government ID is destroyed on redeploy. Fill in the bucket below and switch
# the two disks:
#
#   MEDIA_DISK=s3            photos, job images, certificate and licence scans
#   DOCUMENT_DISK=s3_private government IDs, selfies, resumes
#
# Those two, not FILESYSTEM_DISK. FILESYSTEM_DISK only sets Laravel's default
# disk, and no upload in this app uses the default — each one names media or
# documents explicitly, which is what keeps IDs and resumes off a public URL.
#
# DOCUMENT_DISK must be s3_private, never s3. The private disk sets
# visibility=private and throws on a failed write instead of returning false.
#
# S3-compatible, so Cloudflare R2 and DigitalOcean Spaces work too — they need
# AWS_ENDPOINT set to their host, and R2 wants AWS_DEFAULT_REGION=auto.
MEDIA_DISK=public
DOCUMENT_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Credits and payments ─────────────────────────────────────────────────────
# PayMongo. Sandbox keys during development — live keys need business
# onboarding whose approval time is outside this project's control.
# The webhook secret is issued separately when the webhook is registered;
# without it every incoming call is unverifiable and is refused.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_RETURN_URL=

# What the currency is called on screen. A placeholder — the code uses the
# neutral word "credit" everywhere, so renaming touches only this and one
# matching constant in the app.
CREDIT_NAME=Barya
CREDIT_NAME_PLURAL=Barya

# What actions cost, and the free monthly grant. Set for Philippine local
# service work — see config/kaya.php for the reasoning.
CREDIT_COST_APPLY=2
CREDIT_COST_INVITE=2
CREDIT_COST_UNLOCK=10
CREDIT_MONTHLY_GRANT=20
CREDIT_SIGNUP_GRANT=20
CREDIT_WITHDRAW_REFUND_MINUTES=60
