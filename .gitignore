# ── Secrets ───────────────────────────────────────────────────────────────────
# Never commit OAuth client secrets or service-account keys.
client_secret_*.json
*-service-account*.json
*.pem
*.p12
*.keystore
*.jks

# Environment
.env
.env.*
!.env.example

# ── Tooling artifacts ─────────────────────────────────────────────────────────
composer.phar
composer-setup.php

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# Editor backups
*.bak

# Conflicted with nixpacks.toml as a second start command
kaya_backend/Procfile

# Golden test diff output. Regenerated on every failing run.
kaya_app/test/failures/

# The answer key to the decoy test cases. Never publish this: the four decoys
# only measure whether a tester really opened the app for as long as nobody
# knows which four they are.
TRAP KEY - DO NOT SEND TO TESTER.txt

# Gradle build output. Regenerated on every compile, so it belongs nowhere near
# a commit — one report file had already slipped in.
kaya_app/android/build/
kaya_app/android/.gradle/

# Platform scaffolding this project does not ship. Flutter regenerates these
# whenever it builds, so deleting them once is not enough — without this they
# reappear and get swept into the next `git add .`. This project ships an
# Android app and a Blade admin panel served by Laravel.
kaya_app/ios/
kaya_app/macos/
kaya_app/windows/
kaya_app/linux/
kaya_app/web/

# Database dumps. These carry every user's email and password hash, plus
# whatever else is in the tables, so they must never reach the repo.
kaya_db.sql
*.dump.sql
*_backup.sql

# Claude Code personal settings. Machine-specific paths, not for the repo.
.claude/settings.local.json

# Claude Code config - local only, not for the public repo
CLAUDE.md
.claude/
