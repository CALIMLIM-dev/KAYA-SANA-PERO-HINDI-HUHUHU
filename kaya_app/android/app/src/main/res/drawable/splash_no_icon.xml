<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing, on purpose. Android 12 and later draw the launcher icon on their
    own splash screen before the app starts; the app then builds the same icon
    up from nothing, so the system's copy would appear, vanish and be rebuilt.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
