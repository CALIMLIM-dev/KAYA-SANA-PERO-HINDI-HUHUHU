<?xml version="1.0" encoding="utf-8"?>
<!--
    The KAYA icon going up, played by Android's own splash screen (12 and
    later) the moment the app is tapped. Frames are rendered by
    kaya_app/tool/splash_frames_test.dart from the same build the app uses;
    50 ms each, one second in all, holding on the finished icon.
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="true">
