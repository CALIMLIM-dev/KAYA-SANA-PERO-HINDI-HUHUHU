    <item android:drawable="@drawable/splash_build_11" android:duration="50" />
    <item android:drawable="@drawable/splash_build_12" android:duration="50" />
    <item android:drawable="@drawable/splash_build_13" android:duration="50" />
    <item android:drawable="@drawable/splash_build_14" android:duration="50" />
