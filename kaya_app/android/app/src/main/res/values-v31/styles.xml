<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+: the opening pop-up plays the KAYA icon going up
        (drawable/splash_build.xml) on a white splash. MainActivity holds the
        splash until it has finished; the app then opens on the built icon.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_build</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
