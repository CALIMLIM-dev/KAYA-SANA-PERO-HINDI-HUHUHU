<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alphatech.kaya_app">
    <!-- Internet permission for API calls and Google Sign-In -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Push notifications.

         Only Android 13 (API 33) and above require this at runtime: from 13
         onward a notification cannot be shown until the user grants it, and
         the app must ask. On Android 12 and below notifications are allowed by
         default and nothing is prompted, so declaring it here is harmless on
         older phones and mandatory on newer ones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- "Use my current location" on the pin-drop map (geolocator).
         COARSE alone is enough to resolve a barangay; FINE lets a worker pin
         an exact site. Both are runtime permissions the user can decline —
         the map still works by tapping. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!--
        Location while the app is not on screen, for the job tracker.

        A worker travelling to a job has their phone in a pocket. Android
        suspends timers and cuts location to a backgrounded app, so without a
        foreground service the pings stop and the employer watches a frozen pin
        believing it is current.

        FOREGROUND_SERVICE_LOCATION is required from Android 14; the older
        FOREGROUND_SERVICE covers Android 9-13.

        ACCESS_BACKGROUND_LOCATION cannot be granted from an in-app prompt on
        Android 11+ — the user has to set "Allow all the time" in system
        settings. The tracking panel has to say so, because the permission
        dialog will not.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Keeps the CPU and WiFi awake long enough for a position fix and a ping
         while the screen is off. Without them Doze can suspend the service
         between wakeups and the trail develops gaps that look like the worker
         stopped moving. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Lets the app hand a downloaded APK to the system installer.

         KAYA is distributed as an APK rather than through a store, so nothing
         updates anybody and testers sit on builds from several fixes ago.
         Without this the update path is: open a browser, load a Drive page,
         download, find the file, tap it, then approve. With it the app fetches
         the APK itself and the user sees one Install prompt.

         It does NOT allow a silent install - Android reserves that for the
         store and for device-owner apps, and the user still confirms. This
         only removes the detour. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="KAYA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- taskAffinity was previously set to "" here. An empty affinity means
             the activity belongs to no task, so launching from different entry
             points (launcher, notification, an intent) each spawned a SEPARATE
             task — and every one of them showed its own "KAYA" card in the app
             switcher, stacking up as "KAYA KAYA KAYA".

             Removing it restores the default affinity (the package name), which
             is what the stock Flutter template uses: one task, one entry.
             singleTop then does its job of reusing the existing activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The foreground service that keeps reporting position after the app
             is swiped out of recents.

             foregroundServiceType is mandatory from Android 14: a service that
             does not declare one is refused at start with a
             SecurityException. "location" is the honest declaration, and it is
             the reason this service is permitted to exist at all — a service
             justified as "polls for chat" would not be. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false"
            android:stopWithTask="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for Google Sign-In -->
        <package android:name="com.google.android.gms" />

        <!-- Opening certificates, licences and resumes.

             Android 11 (API 30) hid other installed apps from us unless we
             declare what we intend to open. Without these, url_launcher's
             canLaunchUrl/launchUrl finds no handler and simply returns false —
             so tapping a PDF did nothing at all, with no error and nothing in
             the log to explain it. Images were unaffected because those render
             in-app and never leave Flutter, which is why only PDFs looked
             broken. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>
</manifest>
