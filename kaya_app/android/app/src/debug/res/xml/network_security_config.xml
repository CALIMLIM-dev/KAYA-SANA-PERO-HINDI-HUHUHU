<?xml version="1.0" encoding="utf-8"?>
<!--
    Plain HTTP, for development only.

    This file lives under src/debug, so it is merged into debug builds and
    never into a release. That split is the whole point: the app carries
    government IDs and selfies, and those must never travel unencrypted off a
    real user's phone. A release APK stays HTTPS-only with no exception at all.

    It exists because ngrok used to fill this role. The tunnel was never
    wanted - it was a way to get an HTTPS address for a server running on a
    laptop, because Android refuses plain HTTP by default and the phone could
    not otherwise reach it. Permitting cleartext to the laptop directly does
    the same job with no third party, no tunnel that dies overnight, and no
    interstitial HTML arriving where JSON was expected.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The development machine on the local network. Change this if the
             router hands out a different address. -->
        <domain includeSubdomains="false">192.168.100.4</domain>

        <!-- The Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
